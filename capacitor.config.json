{
  "appId": "com.routine.app",
  "appName": "My Routine",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#38bdf8"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#06080d"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#06080d",
      "showSpinner": false
    }
  }
}