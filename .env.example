# ============================================================================
# Environment Variables Example for RoutineAPP
# Copy this file to .env and fill in your real credentials.
# NOTE: .env is gitignored and will never be committed.
# ============================================================================

# Supabase Production Configuration
SUPABASE_URL="https://<your-project-id>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-secret-service-role-key>"

# Vercel Cron Secret (for authenticating scheduled cloud jobs)
CRON_SECRET="<your-random-cron-secret>"

# Optional: Admin Authentication Password for in-app suggestions moderation
ADMIN_PASSWORD="<your-admin-password>"

# Shared password for posting/editing/deleting announcements (api/announcements.js)
ANNOUNCEMENT_PASSWORD=

# Firebase Admin service account (api/announcements.js) — required for FCM push notifications.
# FIREBASE_PRIVATE_KEY may use literal \n sequences; they are converted to newlines at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# In-app updater (api/app-update.js): fine-grained token, this repo only, Contents read-only.
# Needed once the GitHub repo is private. Set it on Vercel, not in the app.
GITHUB_TOKEN=
