# ============================================================================
# Environment Variables Example for RoutineAPP
# Copy this file to .env and fill in your real credentials.
# NOTE: .env is gitignored and will never be committed.
# ============================================================================

# Supabase Production Configuration
SUPABASE_URL="https://<your-project-id>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-secret-service-role-key>"

# Vercel Cron Secret (for authenticating scheduled cloud jobs)
CRON_SECRET="<your-random-cron-secret>"

# Optional: Admin Authentication Password for in-app suggestions moderation
ADMIN_PASSWORD="<your-admin-password>"
